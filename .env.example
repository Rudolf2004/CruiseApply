NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback; use either publishable key or anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOUCHER_ENCRYPTION_KEY=
# Explicitly enable sample vacancies locally; never enable in production.
DEMO_MODE=false
# Staged voucher authentication. Keep disabled pending separate rollout review.
APPLICANT_AUTH_ENABLED=false
# Optional only behind a proxy that overwrites this header and blocks bypass.
# Supported: cf-connecting-ip or x-real-ip. Blank uses a shared client limit.
APPLICANT_AUTH_TRUSTED_IP_HEADER=

# Applicant recovery email; keep disabled until verified sender configuration.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=

# Explicit payment mode; keep local development in test.
PAYSTACK_MODE=test
PAYSTACK_LIVE_ENABLED=false
