import assert from 'node:assert/strict';
import {randomUUID,randomBytes,createHash} from 'node:crypto';
import {setDefaultResultOrder} from 'node:dns';
import {readFile,writeFile} from 'node:fs/promises';
import {spawn} from 'node:child_process';
import {once} from 'node:events';
import {setTimeout as delay} from 'node:timers/promises';
import {createServer} from 'node:net';
import {createClient} from '@supabase/supabase-js';
import {chromium} from 'playwright-core';
setDefaultResultOrder('ipv4first');
assert.notEqual(process.env.APPLICANT_AUTH_ENABLED,'true');
const base=process.env.NEXT_PUBLIC_APP_URL!,origin=new URL(base);assert.equal(origin.protocol,'http:');assert.equal(origin.hostname,'localhost');
const port=Number(origin.port||80),probe=createServer();probe.listen(port,'127.0.0.1');await once(probe,'listening');await new Promise<void>(resolve=>probe.close(()=>resolve()));
const reliableFetch:typeof fetch=async(input,init)=>{for(let i=0;;i++){try{return await fetch(input,{...init,signal:init?.signal??AbortSignal.timeout(30000)});}catch(e){if(i>=2||!['GET','DELETE'].includes(String(init?.method??'GET')))throw e;await delay(500);}}};
const db=createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!,process.env.SUPABASE_SERVICE_ROLE_KEY!,{auth:{persistSession:false,autoRefreshToken:false},global:{fetch:reliableFetch}});
const catalog=JSON.parse(await readFile('test-results/pricing-controls-0016-local-catalog.json','utf8')),tables=[...new Set<string>(catalog.indexes.map((x:{tablename:string})=>x.tablename))].sort();
let phase='baseline';
let actor:string|undefined,region:string|undefined,baseline:unknown,cleaned=false;const product=randomUUID(),checks:string[]=[];
let child:ReturnType<typeof spawn>|undefined,browser:Awaited<ReturnType<typeof chromium.launch>>|undefined;
function ok<T extends {error:unknown}>(r:T):T{if(r.error)throw new Error('Database request failed');return r;}
async function snapshot(){const out:Record<string,string>={};for(const table of tables){const pk=catalog.constraints.find((x:{table:string;definition:string})=>x.table===table&&x.definition.startsWith('PRIMARY KEY'));assert.ok(pk);const cols=pk.definition.match(/\(([^)]+)\)/)[1].split(',').map((s:string)=>s.trim());const rows=[];for(let page=0;;page++){let q=db.from(table).select('*');for(const c of cols)q=q.order(c);const batch=ok(await q.range(page*500,page*500+499)).data!;rows.push(...batch);if(batch.length<500)break;}out[table]=createHash('sha256').update(JSON.stringify(rows)).digest('hex');}return out;}
async function ledger(){await writeFile('test-results/admin-browser-fixtures.json',JSON.stringify({actor,product,region,cleaned}));}
const pass=(s:string)=>{checks.push(s);console.log('PASS: '+s);};
try{
 baseline=await snapshot();await writeFile('test-results/admin-browser-baseline.json',JSON.stringify(baseline));
 const email='browser-'+randomUUID()+'@example.com',password=randomBytes(32).toString('base64url');actor=ok(await db.auth.admin.createUser({email,password,email_confirm:true})).data.user!.id;await ledger();ok(await db.from('profiles').update({role:'super_admin'}).eq('id',actor));
 ok(await db.from('voucher_types').insert({id:product,name:'Private inactive browser fixture',description:'Private browser verification fixture, never sold.',amount:15000,currency:'GHS',validity_days:90,active:false}));
 phase='production startup';child=spawn(process.execPath,['node_modules/next/dist/bin/next','start','--hostname','127.0.0.1','--port',String(port)],{windowsHide:true,stdio:['ignore','pipe','pipe'],env:{...process.env,NODE_OPTIONS:(process.env.NODE_OPTIONS??'')+' --dns-result-order=ipv4first'}});let ready=false;child.stdout!.on('data',v=>{if(String(v).includes('Ready in'))ready=true;});child.stderr!.on('data',()=>{});const until=Date.now()+180000;while(!ready){assert.ok(child.exitCode===null&&Date.now()<until,'Production startup failed');await delay(250);}
 phase='browser launch';browser=await chromium.launch({executablePath:'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe',headless:true});const context=await browser.newContext();context.setDefaultTimeout(120000);const page=await context.newPage();
 phase='anonymous pricing denial';assert.equal((await context.request.get(base+'/api/admin/records/regions/export')).status(),401);phase='staff login';await page.goto(base+'/login');await page.getByLabel('Email address',{exact:true}).fill(email);await page.getByLabel('Password',{exact:true}).fill(password);await page.getByRole('button',{name:'Sign In',exact:true}).click();await page.waitForURL('**/admin');
 for(const width of [390,1440]){await page.setViewportSize({width,height:900});for(const route of ['/admin/records/payments','/admin/records/vouchers','/admin/records/audit','/admin/records/countries','/admin/records/regions','/admin/records/exchange','/admin/records/overrides','/admin/reports']){phase='page '+route+' '+width;const r=await page.goto(base+route);assert.equal(r?.status(),200);await page.locator('h1').waitFor();assert.equal(await page.getByRole('heading',{name:'Something went wrong',exact:true}).count(),0);assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=window.innerWidth+2),'Page overflow: '+route);}}
 phase='CSV export';const exported=await context.request.get(base+'/api/admin/records/payments/export');assert.equal(exported.status(),200);assert.equal(exported.headers()['cache-control'],'no-store');assert.ok(!(await exported.text()).includes('pin_hash'));assert.equal(ok(await db.from('audit_logs').select('id').eq('actor_id',actor).eq('action','staff_export_prepared')).data!.length,1);
 phase='product editor';await page.goto(base+'/admin/configuration/product/'+product);await page.getByLabel('Price (GHS)',{exact:true}).fill('160.00');await page.getByRole('button',{name:'Save configuration',exact:true}).click();await page.getByRole('status').filter({hasText:'Saved.'}).waitFor();assert.equal(ok(await db.from('voucher_types').select('amount,active').eq('id',product).single()).data!.amount,16000);assert.equal(ok(await db.from('voucher_types').select('active').eq('id',product).single()).data!.active,false);
 phase='region editor';let captured:Record<string,unknown>|undefined;await page.route('**/api/admin/pricing',async route=>{captured=route.request().postDataJSON();region=String(captured!.key);await ledger();await route.continue();});phase='region navigation';const regionPage=await page.goto(base+'/admin/pricing/region/new');console.log('Region page diagnostics:',regionPage?.status(),new URL(page.url()).pathname,await page.locator('h1').allTextContents());await page.screenshot({path:'test-results/region-editor-diagnostic.png',fullPage:true});phase='region code';await page.getByLabel('Region code',{exact:true}).fill('browser-'+randomUUID());phase='region name';await page.getByLabel('Region name',{exact:true}).fill('Private inactive browser region');phase='region submit';await page.getByRole('button',{name:'Save reviewed configuration',exact:true}).click();phase='region redirect';await page.waitForURL(url=>url.pathname.startsWith('/admin/pricing/region/')&&!url.pathname.endsWith('/new'));assert.ok(region&&captured);assert.equal(ok(await db.from('pricing_regions').select('active').eq('id',region).single()).data!.active,false);const replay=await context.request.post(base+'/api/admin/pricing',{headers:{origin:origin.origin},data:captured});assert.equal(replay.status(),200);assert.equal((await replay.json()).replayed,true);
 pass('Real staff login, mobile/desktop record/report views, private audited CSV, inactive product edit, inactive region form and identical retry passed');
 phase='staff role revocation';ok(await db.from('profiles').update({role:'admin'}).eq('id',actor));await page.goto(base+'/admin/configuration/product/'+product);await page.getByRole('alert').filter({hasText:'super administrator'}).waitFor();assert.equal((await context.request.post(base+'/api/admin/pricing',{headers:{origin:origin.origin},data:captured})).status(),403);
 ok(await db.from('profiles').update({role:'applicant'}).eq('id',actor));assert.equal((await context.request.get(base+'/api/admin/records/payments/export')).status(),403);assert.equal((await context.request.get(base+'/api/admin/records/regions/export')).status(),403);await page.goto(base+'/admin/reports');await page.waitForURL(url=>url.pathname==='/dashboard'&&url.searchParams.get('access')==='denied');await context.close();pass('Role revocation denies super-admin changes and nonstaff export/admin pages without changing staff authentication');
}catch(e){process.exitCode=1;console.error('Browser verification failed:',phase,e instanceof assert.AssertionError?e.message:(e as Error).name);}
finally{
 if(browser)await browser.close();if(child&&child.exitCode===null){const closed=once(child,'exit');child.kill();await Promise.race([closed,delay(10000)]);}
 if(baseline){try{if(actor){ok(await db.from('pricing_configuration_commands').delete().eq('actor_id',actor));ok(await db.from('administration_commands').delete().eq('actor_id',actor));}if(region)ok(await db.from('pricing_regions').delete().eq('id',region));ok(await db.from('voucher_types').delete().eq('id',product));if(actor){ok(await db.from('audit_logs').delete().eq('actor_id',actor));ok(await db.auth.admin.deleteUser(actor));}for(const id of [actor,region,product].filter(Boolean))ok(await db.from('audit_logs').delete().eq('target_id',id!));assert.deepEqual(await snapshot(),baseline);cleaned=true;await ledger();pass('All browser fixtures removed and original public-table snapshots unchanged');}catch{process.exitCode=1;console.error('Browser fixture cleanup/preservation failed; inspect ledger');}}
 await writeFile('test-results/admin-controls-browser.json',JSON.stringify({passed:!process.exitCode,cleaned,checks,failurePhase:process.exitCode?phase:null,rollout:false,paystackCalls:0},null,2));
}
