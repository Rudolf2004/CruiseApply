import {setDefaultResultOrder} from 'node:dns';
setDefaultResultOrder('ipv4first');
﻿import assert from 'node:assert/strict';
import {randomUUID,randomBytes,createHash} from 'node:crypto';
import {readFile,writeFile} from 'node:fs/promises';
import {createClient} from '@supabase/supabase-js';
const reliableFetch:typeof fetch=async(input,init)=>{const method=String(init?.method??'GET').toUpperCase();for(let attempt=0;;attempt++){try{return await fetch(input,{...init,signal:init?.signal??AbortSignal.timeout(30000)});}catch(e){if(attempt>=2||!['GET','DELETE'].includes(method))throw e;await new Promise(resolve=>setTimeout(resolve,500));}}};
const url=process.env.NEXT_PUBLIC_SUPABASE_URL!,secret=process.env.SUPABASE_SERVICE_ROLE_KEY!,key=process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY||process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!,options={auth:{persistSession:false,autoRefreshToken:false},global:{fetch:reliableFetch}},db=createClient(url,secret,options),anon=createClient(url,key,options),staff=createClient(url,key,options);
const catalog=JSON.parse(await readFile('test-results/administration-0015-local-catalog.json','utf8')),tables=[...new Set<string>(catalog.indexes.map((x:{tablename:string})=>x.tablename))].sort(),intake=randomUUID(),product=randomUUID(),requestId=randomUUID();let actor:string|undefined,baseline:unknown,cleaned=false;const checks:string[]=[];
function ok<T extends {error:unknown}>(r:T):T{if(r.error)throw new Error('Hosted administration check failed: '+String((r.error as {code?:string}).code??'transport'));return r;}
async function snapshot(){const out:Record<string,string>={};for(const table of tables){const pk=catalog.constraints.find((x:{table:string;definition:string})=>x.table===table&&x.definition.startsWith('PRIMARY KEY'));assert.ok(pk);const cols=pk.definition.match(/\(([^)]+)\)/)[1].split(',').map((s:string)=>s.trim());const rows=[];for(let page=0;;page++){let q=db.from(table).select('*');for(const c of cols)q=q.order(c);const batch=ok(await q.range(page*500,page*500+499)).data!;rows.push(...batch);if(batch.length<500)break;}out[table]=createHash('sha256').update(JSON.stringify(rows)).digest('hex');}return out;}
const pass=(s:string)=>{checks.push(s);console.log('PASS: '+s);};
if(process.argv.includes('--connectivity')){try{const r=await fetch(url+'/auth/v1/health',{headers:{apikey:secret},signal:AbortSignal.timeout(20000)});console.log('Hosted health HTTP',r.status);}catch(e){console.log('Hosted connectivity failed',String((e as {cause?:{code?:string}}).cause?.code??(e as Error).name));}process.exit(0);}
if(process.argv.includes('--cleanup-fixtures')){const f=JSON.parse(await readFile('test-results/administration-hosted-fixtures.json','utf8'));for(const [table,column,value] of [['administration_commands','actor_id',f.actor],['jobs','id',f.intake],['voucher_types','id',f.product],['audit_logs','actor_id',f.actor]]){const r=await db.from(table).delete().eq(column,value);if(r.error){console.error('Cleanup failure',table,r.error.code,r.error.message.slice(0,160));process.exit(1);}}const auth=await db.auth.admin.deleteUser(f.actor);if(auth.error&&auth.error.code!=='user_not_found'){console.error('Auth cleanup failure',auth.error.code);process.exit(1);}for(const id of [f.actor,f.intake,f.product])ok(await db.from('audit_logs').delete().eq('target_id',id));await writeFile('test-results/administration-hosted-fixtures.json',JSON.stringify({...f,cleaned:true}));console.log('Recorded fixtures cleaned');process.exit(0);}
try{baseline=await snapshot();await writeFile('test-results/administration-hosted-baseline.json',JSON.stringify(baseline));const response=await fetch(url+'/rest/v1/',{headers:{apikey:secret,Authorization:'Bearer '+secret},signal:AbortSignal.timeout(30000)});assert.equal(response.status,200);const api=await response.json();for(const c of catalog.constraints.filter((x:{definition:string})=>x.definition.startsWith('NOT NULL')))assert.ok(api.definitions[c.table]?.required?.includes(c.definition.slice(9).replaceAll('"','')));
 const email='g15-'+randomUUID()+'@example.com',password=randomBytes(32).toString('base64url');actor=ok(await db.auth.admin.createUser({email,password,email_confirm:true})).data.user!.id;await writeFile('test-results/administration-hosted-fixtures.json',JSON.stringify({actor,intake,product,cleaned:false}));ok(await staff.auth.signInWithPassword({email,password}));
 const data={id:intake,revision:0,title:'Private administration fixture',slug:'private-'+intake,category:'Hospitality',department:'Guest Services',location:'Worldwide',summary:'Private draft test intake only.',description:'Disposable private administration test. Never published.',serviceDescription:'Private CruiseApply test fixture. No opportunity, referral or employment is offered.',status:'draft',requiredDocuments:[],questions:[]};const args={p_request_id:requestId,p_actor_id:actor,p_operation:'intake_save',p_data:data};
 for(const client of [anon,staff])assert.equal((await client.rpc('save_administration_record',args)).error?.code,'42501');assert.equal((await db.rpc('save_administration_record',args)).error?.code,'P0001');ok(await db.from('profiles').update({role:'admin'}).eq('id',actor));
 const results=await Promise.all(Array.from({length:6},()=>db.rpc('save_administration_record',args)));for(const r of results)ok(r);assert.equal(results.filter(r=>!r.data.replayed).length,1);assert.equal(ok(await db.from('audit_logs').select('id').eq('target_id',intake).eq('action','intake_save')).data!.length,1);
 for(const p_data of [{...data,title:'Conflicting retry'},data])assert.equal((await db.rpc('save_administration_record',{...args,p_request_id:p_data===data?randomUUID():requestId,p_data})).error?.code,'P0001');
 assert.equal(ok(await staff.from('administration_commands').select('request_id').eq('request_id',requestId)).data!.length,1);ok(await db.from('profiles').update({role:'applicant'}).eq('id',actor));assert.equal(ok(await staff.from('administration_commands').select('request_id').eq('request_id',requestId)).data!.length,0);assert.equal((await db.rpc('save_administration_record',{...args,p_request_id:randomUUID(),p_data:{...data,revision:1}})).error?.code,'P0001');
 ok(await db.from('voucher_types').insert({id:product,name:'Private inactive product fixture',description:'Disposable test fixture, never sold.',amount:15000,currency:'GHS',validity_days:90,active:false}));const price={p_request_id:randomUUID(),p_actor_id:actor,p_operation:'product_save',p_data:{id:product,revision:0,name:'Private inactive product fixture',description:'Disposable test fixture, never sold.',amount:16000,validityDays:90,active:false}};ok(await db.from('profiles').update({role:'admin'}).eq('id',actor));assert.equal((await db.rpc('save_administration_record',price)).error?.code,'P0001');ok(await db.from('profiles').update({role:'super_admin'}).eq('id',actor));ok(await db.rpc('save_administration_record',price));assert.equal(ok(await db.from('voucher_types').select('amount').eq('id',product).single()).data!.amount,16000);
 pass('Service-only authorization, staff revocation/RLS, six identical saves, one audit, conflicting retries, stale revisions and super-admin pricing pass; fixture intake/product stayed draft/inactive');
}catch{process.exitCode=1;console.error('FAIL: inspect administration fixture ledger; no secrets logged');}finally{if(baseline){try{if(actor)ok(await db.from('administration_commands').delete().eq('actor_id',actor));ok(await db.from('jobs').delete().eq('id',intake));ok(await db.from('voucher_types').delete().eq('id',product));if(actor){ok(await db.from('audit_logs').delete().eq('actor_id',actor));ok(await db.auth.admin.deleteUser(actor));}for(const target of [intake,product,actor].filter(Boolean))ok(await db.from('audit_logs').delete().eq('target_id',target!));assert.deepEqual(await snapshot(),baseline);cleaned=true;pass('All fixtures removed and every original public-table snapshot unchanged');}catch(e){process.exitCode=1;console.error('Cleanup/preservation failed:', e instanceof assert.AssertionError ? 'snapshot mismatch' : (e as Error).message);await writeFile('test-results/administration-hosted-after.json',JSON.stringify(await snapshot()));}}await writeFile('test-results/administration-0015-hosted.json',JSON.stringify({passed:!process.exitCode,cleaned,checks,paystackCalls:0,rollout:false},null,2));if(actor)await writeFile('test-results/administration-hosted-fixtures.json',JSON.stringify({actor,intake,product,cleaned}));}
