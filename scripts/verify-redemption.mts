// Non-consuming checks against the accepted paid voucher. No payment initialization.
import assert from "node:assert/strict";
import { randomUUID } from "node:crypto";
import { readFile } from "node:fs/promises";
import { createClient } from "@supabase/supabase-js";
import { chromium } from "playwright-core";
import { decryptVoucherPin, verifyVoucherPin } from "../src/lib/voucher-credentials.ts";
assert.ok(process.env.PAYSTACK_SECRET_KEY?.startsWith("sk_test_"), "Test configuration required.");
const state = JSON.parse(await readFile("test-results/checkout-e2e-state.json","utf8"));
const base = process.env.NEXT_PUBLIC_APP_URL || "http://localhost:3000";
const options = { auth: { persistSession: false, autoRefreshToken: false } };
const db = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!,process.env.SUPABASE_SERVICE_ROLE_KEY!,options);
const publicDb = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!,process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY || process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!,options);
const lookup = await db.from("vouchers").select("id,user_id,status,payment_id,pin_hash,pin_encrypted").eq("serial","CRV-2026-00000003").eq("user_id",state.id).single();
assert.ok(!lookup.error && lookup.data,"Original owner's voucher required."); const voucher = lookup.data;
assert.equal(voucher.status,"unused","This runner never consumes or resets a used voucher.");
const nonexistentJob = randomUUID();
assert.equal((await db.from("jobs").select("id").eq("id",nonexistentJob)).data?.length,0);
const args = { p_user_id: state.id,p_serial: "CRV-2026-00000003",p_pin_hash: "invalid",p_job_id: nonexistentJob };
assert.ok((await publicDb.rpc("redeem_verified_voucher",args)).error,"Anonymous RPC access must fail.");
assert.ok(!(await publicDb.auth.signInWithPassword({ email: state.email,password: state.password })).error);
assert.ok((await publicDb.rpc("redeem_verified_voucher",args)).error,"Applicant direct RPC access must fail.");
assert.ok((await publicDb.from("vouchers").select("pin_hash,pin_encrypted")).error,"Credential columns remain restricted.");
const beforeApps = await db.from("applications").select("id",{ count: "exact" }).eq("voucher_id",voucher.id);
const beforeNotifications = await db.from("notifications").select("id",{ count: "exact" }).eq("user_id",state.id);
const browser = await chromium.launch({ channel: "msedge",headless: true });
try {
  const context = await browser.newContext({ viewport: { width: 390,height: 844 } });
  const endpoint = `${base}/api/vouchers/redeem`;
  const body = { serial: "CRV-2026-00000003",pin: "00000000",jobId: nonexistentJob };
  assert.equal((await context.request.post(endpoint,{ headers: { Origin: new URL(base).origin },data: body,timeout: 120000 })).status(),401);
  const login = await context.request.post(`${base}/api/auth/login`,{ headers: { Origin: new URL(base).origin },data: { email: state.email,password: state.password },timeout: 120000 });
  assert.equal(login.status(),200);
  assert.equal((await context.request.post(endpoint,{ headers: { Origin: "https://foreign.invalid" },data: body,timeout: 120000 })).status(),403);
  while (await verifyVoucherPin(body.pin,voucher.pin_hash)) body.pin = String(Number(body.pin)+1).padStart(8,"0");
  assert.equal((await context.request.post(endpoint,{ headers: { Origin: new URL(base).origin },data: body,timeout: 120000 })).status(),400);
  body.pin = decryptVoucherPin(voucher.pin_encrypted);
  assert.equal((await context.request.post(endpoint,{ headers: { Origin: new URL(base).origin },data: body,timeout: 120000 })).status(),409,"Valid PIN cannot redeem against a nonexistent vacancy.");
  const page = await context.newPage();
  await page.goto(`${base}/voucher/verify`,{ waitUntil: "domcontentloaded",timeout: 120000 });
  await page.getByRole("heading",{ name: "Activate your voucher" }).waitFor();
  await page.screenshot({ path: "test-results/redemption-mobile.png",fullPage: true });
  assert.equal(await page.evaluate(() => document.documentElement.scrollWidth > innerWidth),false,"Mobile layout must not overflow.");
  await page.screenshot({ path: "test-results/redemption-mobile.png",fullPage: true });
  const after = await db.from("vouchers").select("status").eq("id",voucher.id).single();
  assert.equal(after.data?.status,"unused");
  assert.equal((await db.from("applications").select("id",{ count: "exact" }).eq("voucher_id",voucher.id)).count,beforeApps.count);
  assert.equal((await db.from("notifications").select("id",{ count: "exact" }).eq("user_id",state.id)).count,beforeNotifications.count);
  const jobs = await db.from("jobs").select("id",{ count: "exact" }).eq("status","published").eq("sample",false).or(`application_deadline.is.null,application_deadline.gt.${new Date().toISOString()}`);
  assert.ok(!jobs.error);
  console.log(`PASS: auth, same-origin, PIN checks, service-only RPC, restricted credentials, invalid-job rollback and mobile redemption page. Eligible vacancies: ${jobs.count}. Paid voucher remains unused; no application or notification added.`);
} finally { await browser.close(); await publicDb.auth.signOut({ scope: "local" }); }
