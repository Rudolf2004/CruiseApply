 for(const [entity,key,data] of [['contact','PAYSTACK_SECRET_KEY',{value:'forbidden'}],['exchange','USD',{rate:'0.1'}]])assert.equal((await db.rpc('save_pricing_configuration',{p_request_id:randomUUID(),p_actor_id:actor,p_entity:entity,p_key:key,p_expected:null,p_data:data})).error?.code,'P0001');
