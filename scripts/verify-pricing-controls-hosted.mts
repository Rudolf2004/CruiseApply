 const email='g16-'+randomUUID()+'@example.com',password=randomBytes(32).toString('base64url');actor=ok(await db.auth.admin.createUser({email,password,email_confirm:true})).data.user!.id;await writeFile('test-results/pricing-controls-hosted-fixtures.json',JSON.stringify({actor,intake,product,region,override,cleaned:false}));ok(await staff.auth.signInWithPassword({email,password}));
