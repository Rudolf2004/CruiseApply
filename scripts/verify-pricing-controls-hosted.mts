}catch{process.exitCode=1;console.error('FAIL: inspect administration fixture ledger; no secrets logged');}finally{if(baseline){try{if(actor)ok(await db.from('pricing_configuration_commands').delete().eq('actor_id',actor));ok(await db.from('voucher_price_overrides').delete().eq('id',override));ok(await db.from('pricing_regions').delete().eq('id',region));if(actor)ok(await db.from('administration_commands').delete().eq('actor_id',actor));ok(await db.from('jobs').delete().eq('id',intake));ok(await db.from('voucher_types').delete().eq('id',product));if(actor){ok(await db.from('audit_logs').delete().eq('actor_id',actor));ok(await db.auth.admin.deleteUser(actor));}for(const target of [intake,product,region,override,actor].filter(Boolean))ok(await db.from('audit_logs').delete().eq('target_id',target!));assert.deepEqual(await snapshot(),baseline);cleaned=true;pass('All fixtures removed and every original public-table snapshot unchanged');}catch(e){process.exitCode=1;console.error('Cleanup/preservation failed:', e instanceof assert.AssertionError ? 'snapshot mismatch' : (e as Error).message);await writeFile('test-results/pricing-controls-hosted-after.json',JSON.stringify(await snapshot()));}}await writeFile('test-results/pricing-controls-0016-hosted.json',JSON.stringify({passed:!process.exitCode,cleaned,checks,paystackCalls:0,rollout:false},null,2));if(actor)await writeFile('test-results/pricing-controls-hosted-fixtures.json',JSON.stringify({actor,intake,product,region,override,cleaned}));}
