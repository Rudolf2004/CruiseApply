async function snapshot(){const out:Record<string,string>={};for(const table of tables){const pk=catalog.constraints.find((x:{table:string;definition:string})=>x.table===table&&x.definition.startsWith('PRIMARY KEY'));assert.ok(pk);const cols=pk.definition.match(/\(([^)]+)\)/)[1].split(',').map((s:string)=>s.trim());const rows=[];for(let page=0;;page++){let q=db.from(table).select('*');for(const c of cols)q=q.order(c);const batch=ok(await q.range(page*500,page*500+499)).data!;rows.push(...batch);if(batch.length<500)break;}out[table]=createHash('sha256').update(JSON.stringify(rows)).digest('hex');}return out;}
