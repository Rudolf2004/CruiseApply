 ok(await db.from('voucher_types').insert({id:product,name:'Private inactive product fixture',description:'Disposable test fixture, never sold.',amount:15000,currency:'GHS',validity_days:90,active:false}));const price={p_request_id:randomUUID(),p_actor_id:actor,p_operation:'product_save',p_data:{id:product,revision:0,name:'Private inactive product fixture',description:'Disposable test fixture, never sold.',amount:16000,validityDays:90,active:false}};ok(await db.from('profiles').update({role:'admin'}).eq('id',actor));assert.equal((await db.rpc('save_administration_record',price)).error?.code,'P0001');ok(await db.from('profiles').update({role:'super_admin'}).eq('id',actor));ok(await db.rpc('save_administration_record',price));assert.equal(ok(await db.from('voucher_types').select('amount').eq('id',product).single()).data!.amount,16000);
 const regionData={code:'fixture-'+region,name:'Inactive verification region',display_currency:'GHS',active:false};
 const pricing={p_request_id:randomUUID(),p_actor_id:actor,p_entity:'region',p_key:region,p_expected:null,p_data:regionData};
