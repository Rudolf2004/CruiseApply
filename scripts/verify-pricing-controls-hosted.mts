 ok(await db.from('profiles').update({role:'applicant'}).eq('id',actor));assert.equal(ok(await staff.from('pricing_configuration_commands').select('request_id').eq('actor_id',actor)).data!.length,0);assert.equal((await db.rpc('record_staff_export',{p_actor_id:actor,p_kind:'payments',p_page:1,p_count:0})).error?.code,'P0001');
