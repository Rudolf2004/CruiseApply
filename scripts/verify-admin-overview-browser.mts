import assert from 'node:assert/strict';
import {readFile,writeFile} from 'node:fs/promises';
import {chromium} from 'playwright-core';
const local=await readFile('test-results/local-super-admin-login.txt','utf8'),email=local.match(/^Email: (.+)$/m)?.[1].trim(),password=local.match(/^Temporary password: (.+)$/m)?.[1].trim();assert.ok(email&&password);
const browser=await chromium.launch({executablePath:'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe',headless:true});let phase='login';
try{const context=await browser.newContext(),page=await context.newPage();page.setDefaultTimeout(120000);await page.goto('http://localhost:3000/login');await page.getByLabel('Email address',{exact:true}).fill(email);await page.getByLabel('Password',{exact:true}).fill(password);await page.getByRole('button',{name:'Sign In',exact:true}).click();await page.waitForURL('**/admin');await page.getByRole('heading',{name:'Application Overview',exact:true}).waitFor();
const total=Number((await page.locator('.overview-metric strong').first().textContent())?.replaceAll(',',''));const statusCounts=await page.locator('.status-legend strong').allTextContents();assert.equal(statusCounts.reduce((sum,value)=>sum+Number(value),0),total);
for(const width of [1750,1024,390]){phase='viewport '+width;await page.setViewportSize({width,height:1000});await page.getByRole('heading',{name:'Recent Applications',exact:true}).waitFor();assert.equal(await page.locator('.overview-metric').count(),4);assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+2),'Horizontal page overflow');await page.screenshot({path:'test-results/admin-overview-'+width+'.png',fullPage:true});if(width===390){await page.getByRole('button',{name:'Open navigation',exact:true}).click();await page.getByRole('navigation',{name:'Administration',exact:true}).getByRole('link',{name:'Dashboard',exact:true}).waitFor();await page.getByRole('button',{name:'Close navigation',exact:true}).first().click();}}
phase='date range';await page.getByLabel('Chart period').selectOption('7');await page.getByRole('button',{name:'Apply',exact:true}).click();await page.waitForURL('**/admin?days=7');await page.getByRole('img',{name:/last 7 days/}).waitFor();await page.locator('.chart-data summary').click();assert.equal(await page.locator('.chart-data tbody tr').count(),7);
phase='navigation';await page.getByRole('link',{name:'View Applications',exact:true}).click();await page.getByRole('heading',{name:'Candidate screening',exact:true}).waitFor();await page.goto('http://localhost:3000/admin');
const reference=await page.locator('.recent-application strong').first().textContent().catch(()=>null);if(reference){phase='search';await page.getByLabel('Search application reference',{exact:true}).fill(reference);await page.getByRole('button',{name:'Search',exact:true}).click();await page.waitForURL(url=>url.pathname==='/admin/applications'&&url.searchParams.get('q')===reference);await page.getByRole('heading',{name:'Candidate screening',exact:true}).waitFor();}
await writeFile('test-results/admin-overview-browser.json',JSON.stringify({passed:true,widths:[1750,1024,390],checks:['Staff login','Live metric cards','No horizontal page overflow','Mobile navigation','7-day chart and accessible daily table','Quick action and reference search'],businessWrites:0},null,2));console.log('PASS: admin overview browser and responsive checks');await context.close();}catch{console.error('Admin overview browser check failed at '+phase);process.exitCode=1;}finally{await browser.close();}
