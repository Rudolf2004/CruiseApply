import assert from 'node:assert/strict';
import {randomUUID,createHash} from 'node:crypto';
import {readFile,writeFile} from 'node:fs/promises';
import type {PGlite} from '../test-results/sql-review/node_modules/@electric-sql/pglite/dist/index.js';
export async function verifyPricingControls(db:PGlite,ids:{staff:string;owner:string;product:string}){
 const q=async(s:string,p:unknown[]=[])=> (await db.query(s,p)).rows as Record<string,unknown>[];
 const reject=async(s:string,p:unknown[]=[],code='P0001')=>{try{await db.query(s,p);assert.fail('Expected rejection');}catch(e){assert.equal((e as {code?:string}).code,code);}};
 const sql=await readFile('supabase/migrations/202610100016_pricing_settings.sql','utf8');await db.exec('reset role');
 const tables=(await q("select tablename from pg_tables where schemaname='public' order by tablename")).map(r=>r.tablename);async function snapshot(){const out=[];for(const t of tables)out.push(await q(`select to_jsonb(t) as row from public.${t} t order by to_jsonb(t)::text`));return JSON.stringify(out);}
 const before=await snapshot();try{await db.exec(sql.replace(/commit;\s*$/,'select 1/0;commit;'));assert.fail();}catch(e){assert.equal((e as {code?:string}).code,'22012');await db.exec('rollback');}await db.exec(sql);assert.equal(await snapshot(),before);
 const call=(entity:string,key:string,expected:unknown,data:unknown,id=randomUUID(),actor=ids.staff)=>q('select public.save_pricing_configuration($1,$2,$3,$4,$5,$6) as result',[id,actor,entity,key,expected,data]);
 const row=async(table:string,key:string,value:string)=>(await q(`select to_jsonb(t) as value from public.${table} t where ${key}=$1`,[value]))[0]?.value??null;
 for(const role of ['anon','authenticated']){await db.exec('set role '+role);await reject('select public.save_pricing_configuration(null,null,null,null,null,null)',[],'42501');await reject('select public.record_staff_export(null,null,null,null)',[],'42501');await db.exec('reset role');}
 const region=randomUUID(),data={code:'local-pricing-test',name:'Local pricing fixture',display_currency:'USD',active:true},id=randomUUID();
 await q("update public.profiles set role='admin' where id=$1",[ids.staff]);await reject('select public.save_pricing_configuration($1,$2,$3,$4,$5,$6)',[id,ids.staff,'region',region,null,data]);await q("update public.profiles set role='super_admin' where id=$1",[ids.staff]);
 await call('region',region,null,data,id);assert.equal(((await call('region',region,null,data,id))[0].result as {replayed:boolean}).replayed,true);
 await reject('select public.save_pricing_configuration($1,$2,$3,$4,$5,$6)',[id,ids.staff,'region',region,null,{...data,name:'Different retry'}]);await reject('select public.save_pricing_configuration($1,$2,$3,$4,$5,$6)',[randomUUID(),ids.staff,'region',region,null,data]);
 const historical=JSON.stringify(await q('select to_jsonb(p) as row from public.payments p order by id')),quotes=JSON.stringify(await q('select to_jsonb(p) as row from public.payment_quotes p order by id'));
 await call('country','US',await row('pricing_countries','code','US'),{region_id:region});
 await call('exchange','USD',await row('pricing_exchange_rates','quote_currency','USD'),{rate:'0.1',source:'Isolated local fixture only',as_of:'2026-01-01T00:00:00Z',valid_until:'2027-01-01T00:00:00Z'});
 const override=randomUUID();await call('override',override,null,{voucher_type_id:ids.product,country_code:'US',region_id:null,charge_amount:17000,active:false});
 await call('contact','support_email',await row('platform_settings','key','support_email'),{value:'support@example.invalid'});assert.equal((await row('platform_settings','key','support_email') as {public:boolean}).public,true);
 for(const [entity,key,expected,bad] of [['country','US',await row('pricing_countries','code','US'),{region_id:region,active:false}],['exchange','GHS',null,{rate:'1',source:'local',as_of:'2026-01-01T00:00:00Z',valid_until:'2027-01-01T00:00:00Z'}],['override',randomUUID(),null,{voucher_type_id:ids.product,country_code:'US',region_id:region,charge_amount:17000,active:true}],['contact','PAYSTACK_SECRET_KEY',null,{value:'forbidden'}]])await reject('select public.save_pricing_configuration($1,$2,$3,$4,$5,$6)',[randomUUID(),ids.staff,entity,key,expected,bad]);
 assert.equal(JSON.stringify(await q('select to_jsonb(p) as row from public.payments p order by id')),historical);assert.equal(JSON.stringify(await q('select to_jsonb(p) as row from public.payment_quotes p order by id')),quotes);
 await reject('select public.record_staff_export($1,$2,1,1)',[ids.owner,'payments']);await reject('select public.record_staff_export($1,$2,1,1)',[ids.staff,'voucher_access']);await q('select public.record_staff_export($1,$2,1,25)',[ids.staff,'payments']);
 await q("select set_config('request.jwt.claim.sub',$1,false)",[ids.owner]);await db.exec('set role authenticated');assert.equal((await q('select * from public.pricing_configuration_commands')).length,0);await db.exec('reset role');
 for(const a of await q("select metadata from public.audit_logs where action in ('pricing_configuration_saved','staff_export_prepared')"))assert.ok(!/support@|source|rate|value|expected/.test(JSON.stringify(a.metadata)));
 const catalog=(await q(await readFile('supabase/configuration/verify-0016-readonly.sql','utf8')))[0].verification_0016;await writeFile('test-results/pricing-controls-0016-local-catalog.json',JSON.stringify(catalog,null,2));await writeFile('test-results/pricing-controls-0016-local.json',JSON.stringify({passed:true,sqlSha256:createHash('sha256').update(sql).digest('hex'),hosted:false,checks:['Atomic install/rollback with no business-row changes','Service-only RPC, super-admin config authorization and staff export authorization','Exact expected row and request replay/conflict handling','Region/country/FX/override/contact validation; arbitrary secret settings denied','Payment/quote snapshots unchanged','Applicant command denial and metadata minimization'],limitations:['Real multi-connection races require hosted verification']},null,2));console.log('PASS 0016: pricing/settings/export-audit operations, preservation, rollback and authorization');
}
