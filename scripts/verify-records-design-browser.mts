import assert from 'node:assert/strict';
import {readFile,writeFile} from 'node:fs/promises';
import {chromium} from 'playwright-core';
const local=await readFile('test-results/local-super-admin-login.txt','utf8');const email=local.match(/^Email: (.+)$/m)?.[1].trim(),password=local.match(/^Temporary password: (.+)$/m)?.[1].trim();assert.ok(email&&password);
const base=process.env.RECORDS_TEST_ORIGIN||'http://localhost:3000';let phase='login';const browser=await chromium.launch({executablePath:'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe',headless:true});
try{const context=await browser.newContext(),page=await context.newPage();page.setDefaultTimeout(120000);phase='staff API login';const loginResponse=await context.request.post(base+'/api/auth/login',{headers:{origin:base},data:{full_name:'',email,password},timeout:120000});assert.equal(loginResponse.status(),200,'Staff API login failed');await page.goto(base+'/admin');await page.waitForURL('**/admin');for(const width of [1800,1024,390]){phase='viewport '+width;await page.setViewportSize({width,height:1000});await page.goto(base+'/admin/records/payments');await page.getByRole('heading',{name:'Payments',exact:true}).waitFor();assert.equal(await page.locator('.records-tabs a[aria-current=page]').textContent(),'Payments');assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+2),'Page overflow');assert.ok((await page.locator('.records-download').getAttribute('href'))?.startsWith('/api/admin/records/payments/export'));await page.screenshot({path:'test-results/records-design-'+width+'.png',fullPage:true});}
phase='status filter';await page.getByLabel('Status',{exact:true}).selectOption('pending');await page.locator('.records-filters').getByRole('button',{name:'Search',exact:true}).click();await page.waitForURL(url=>url.searchParams.get('status')==='pending');for(const value of await page.locator('.records-status').allTextContents())assert.equal(value,'Pending');assert.ok((await page.locator('.records-download').getAttribute('href'))?.includes('status=pending'));
phase='empty search';await page.getByLabel('Search reference',{exact:true}).fill('NO-MATCH-DESIGN-VERIFICATION');await page.locator('.records-filters').getByRole('button',{name:'Search',exact:true}).click();await page.getByRole('heading',{name:'No matching records'}).waitFor();await page.locator('.records-filters').getByRole('link',{name:'Clear filters'}).click();await page.waitForURL(url=>url.pathname==='/admin/records/payments'&&!url.search);
phase='pagination';await page.goto(base+'/admin/records/countries');await page.getByRole('navigation',{name:'Record pages'}).getByRole('link',{name:'Next'}).click();await page.waitForURL(url=>url.searchParams.get('page')==='2');await page.locator('.records-summary').getByText(/Page 2/).waitFor();assert.ok((await page.locator('.records-download').getAttribute('href'))?.includes('page=2'));
await context.close();await writeFile('test-results/records-design-browser.json',JSON.stringify({passed:true,widths:[1800,1024,390],checks:['Active tabs','Responsive table containment','Status filter','Empty search and clear','Country pagination','Export URL preserves page and filters'],businessWrites:0},null,2));console.log('PASS: records redesign browser checks');}catch(error){await writeFile('test-results/records-browser-error.txt',String(error));console.error('Records browser verification failed at '+phase);process.exitCode=1;}finally{await browser.close();}


